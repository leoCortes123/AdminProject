{
  "extends": "@devcycle/config/tsconfig.nestjs.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
    "verbatimModuleSyntax": false
