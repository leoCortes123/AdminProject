# Copiar a apps/api/.env y ajustar. Nunca commitear .env (ver .gitignore).
# Genera un secreto: openssl rand -base64 48
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://devcycle:devcycle@localhost:5432/devcycle
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
BETTER_AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Adjuntos (F2-T05): FS en dev (UPLOADS_DIR por defecto ./data/uploads);
# S3/MinIO en prod si S3_BUCKET está definido.
UPLOADS_DIR=./data/uploads
# S3_BUCKET=devcycle-attachments
