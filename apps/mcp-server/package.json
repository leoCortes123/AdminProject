{
  "name": "@devcycle/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor MCP read-only de DevCycle (Fase 6b): traduce tools/resources/prompts MCP a la API de integración. Nunca accede a PostgreSQL.",
  "type": "commonjs",
  "bin": {
    "devcycle-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts -- --token dummy --product kanora",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@devcycle/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@devcycle/config": "workspace:*",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
