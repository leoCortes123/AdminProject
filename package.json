{
  "name": "devcycle",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de gestión del ciclo de vida del software (multiproducto, trazabilidad, agentes IA)",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @devcycle/db generate",
    "db:migrate": "pnpm --filter @devcycle/db migrate",
    "db:seed": "pnpm --filter @devcycle/db seed",
    "demo": "docker compose up -d postgres && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
